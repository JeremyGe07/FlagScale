+class SegmentModuleBlock(torch.nn.Module):
+    def __init__(self, stage_id, segment_index, config, pg_collection, layers):
+        super().__init__()
+        self.stage_id = stage_id
+        self.segment_index = segment_index
+        self.config = config
+        self.pg_collection = pg_collection
+        self.layers = torch.nn.ModuleList(layers)
+        self.layer_number = self.layers[0].layer_number if self.layers else 0
+        self.current_microbatch = getattr(self.layers[0], "current_microbatch", -1)
+
+    def forward(self, hidden_states, attention_mask=None, context=None, **kwargs):
+        use_inner_quantization_context = kwargs.pop("use_inner_quantization_context", False)
+        for layer in self.layers:
+            layer.current_microbatch = self.current_microbatch
+            layer_config = getattr(layer, "config", self.config)
+            if use_inner_quantization_context and layer.layer_number > 0:
+                if layer_config.fp8:
+                    inner_quantization_context = get_fp8_context(
+                        layer_config, layer.layer_number - 1
+                    )
+                elif layer_config.fp4:
+                    inner_quantization_context = get_fp4_context(
+                        layer_config, layer.layer_number - 1
+                    )
+                else:
+                    inner_quantization_context = nullcontext()
+            else:
+                inner_quantization_context = nullcontext()
+
+            with inner_quantization_context:
+                hidden_states, context = layer(
+                    hidden_states=hidden_states,
+                    attention_mask=attention_mask,
+                    context=context,
+                    **kwargs,
+                )
+        return hidden_states, context
+
