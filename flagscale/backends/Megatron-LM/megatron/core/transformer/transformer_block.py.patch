+class SegmentRedistributionBoundary(torch.nn.Module):
+    def __init__(self, stage_id, source_index, target_index, transition, source_pg, target_pg):
+        super().__init__()
+        self.stage_id = stage_id
+        self.source_segment_index = source_index
+        self.target_segment_index = target_index
+        self.layer_number = 0
+        self.source_mesh = dict(transition.source_mesh)
+        self.target_mesh = dict(transition.target_mesh)
+        self.batch_unit = transition.batch_unit
+        self.redistribution_kind = transition.redistribution_kind
+        self.requires_sequence_parallel = transition.requires_sequence_parallel
+        self.source_pg_collection = source_pg
+        self.target_pg_collection = target_pg
+
+    def forward(self, hidden_states, attention_mask=None, context=None, **_kwargs):
+        hidden_states = _redistribute_segment_tensor(
+            hidden_states,
+            self.source_mesh,
+            self.target_mesh,
+            self.source_pg_collection,
+            self.target_pg_collection,
+            self.requires_sequence_parallel,
+        )
+        if torch.is_tensor(context):
+            context = _redistribute_segment_tensor(
+                context,
+                self.source_mesh,
+                self.target_mesh,
+                self.source_pg_collection,
+                self.target_pg_collection,
+                self.requires_sequence_parallel,
+            )
+        return hidden_states, context
+
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        return {}
+
+
+def _redistribute_segment_tensor(
+    tensor,
+    source_mesh,
+    target_mesh,
+    source_pg,
+    target_pg,
+    requires_sequence_parallel,
+):
+    if tensor is None or not torch.is_tensor(tensor):
+        return tensor
+    redistributed = tensor
+    if source_mesh["tp"] > 1 and requires_sequence_parallel:
+        redistributed = _gather_tensor_axis(redistributed, source_pg.tp, 0)
+    if source_mesh["dp"] > 1:
+        redistributed = _gather_tensor_axis(redistributed, source_pg.dp, 1)
+    if target_mesh["dp"] > 1:
+        redistributed = _slice_tensor_axis(redistributed, target_pg.dp, 1)
+    if target_mesh["tp"] > 1 and requires_sequence_parallel:
+        redistributed = _slice_tensor_axis(redistributed, target_pg.tp, 0)
+    return redistributed.contiguous()
+
+
+def _gather_tensor_axis(tensor, group, axis):
+    if group is None or group.size() == 1:
+        return tensor
+    gathered = dist_nn_functional.all_gather(tensor.contiguous(), group=group)
+    return torch.cat(gathered, dim=axis)
+
+
+def _slice_tensor_axis(tensor, group, axis):
+    if group is None or group.size() == 1:
+        return tensor
+    if tensor.size(axis) % group.size() != 0:
+        raise ValueError(f"segment redistribution axis {axis} is not divisible by group size")
+    shard = tensor.size(axis) // group.size()
+    return tensor.narrow(axis, group.rank() * shard, shard)
+
+
+def _mesh_dict_from_segment(mesh):
+    return {
+        "tp": mesh.tensor_model_parallel_size,
+        "cp": mesh.context_parallel_size,
+        "ep": mesh.expert_model_parallel_size,
+        "dp": mesh.data_parallel_size,
+        "pp": mesh.pp_local,
+    }
+
+
+def _stage_shell_mesh(config):
+    return {
+        "tp": config.tensor_model_parallel_size,
+        "cp": config.context_parallel_size,
+        "ep": config.expert_model_parallel_size,
+        "dp": getattr(config, "data_parallel_size", 1),
+        "pp": 1,
+    }
+
+
+def _same_mesh(source_mesh, target_mesh):
+    return all(source_mesh[key] == target_mesh[key] for key in ("tp", "cp", "ep", "dp", "pp"))
+
+
+def _edge_redistribution_kind(source_mesh, target_mesh):
+    if source_mesh["cp"] != target_mesh["cp"] or source_mesh["ep"] != target_mesh["ep"]:
+        raise ValueError("segment stage-shell boundary only supports tp/dp redistribution")
+    tp_changed = source_mesh["tp"] != target_mesh["tp"]
+    dp_changed = source_mesh["dp"] != target_mesh["dp"]
+    if tp_changed and dp_changed:
+        return "tp-dp"
+    if tp_changed:
+        return "tp-only"
+    if dp_changed:
+        return "dp-only"
+    raise ValueError("segment stage-shell boundary requires a mesh change")
+
+
+def _stage_shell_transition(source_mesh, target_mesh, config):
+    return StageShellTransition(
+        source_mesh=source_mesh,
+        target_mesh=target_mesh,
+        batch_unit=0,
+        redistribution_kind=_edge_redistribution_kind(source_mesh, target_mesh),
+        requires_sequence_parallel=config.sequence_parallel,
+    )
+
+
+def _append_stage_shell_boundary(
+    execution_layers,
+    stage_id,
+    source_index,
+    target_index,
+    source_mesh,
+    target_mesh,
+    source_pg,
+    target_pg,
+    config,
+):
+    if _same_mesh(source_mesh, target_mesh):
+        return
+    execution_layers.append(
+        SegmentRedistributionBoundary(
+            stage_id,
+            source_index,
+            target_index,
+            _stage_shell_transition(source_mesh, target_mesh, config),
+            source_pg,
+            target_pg,
+        )
+    )
+
+
+def _get_segment_stage_spec(config, pp_rank):
+    runtime_spec = getattr(config, "segment_runtime_spec", None)
+    if runtime_spec is None:
+        return None, None
+    stage_id = getattr(config, "segment_stage_id", None)
+    stage_id = pp_rank if stage_id is None else stage_id
+    stages = getattr(runtime_spec, "stages", ())
+    if stage_id < 0 or stage_id >= len(stages):
+        raise ValueError("segment runtime stage id is out of range")
+    return stage_id, stages[stage_id]
+
+
+def _validate_segment_stage_spec(stage_id, stage_spec):
+    meshes = tuple(getattr(stage_spec, "segment_meshes", ()))
+    splits = tuple(getattr(stage_spec, "segment_splits", ()))
+    transitions = tuple(getattr(stage_spec, "transitions", ()))
+    if any(getattr(mesh, "pp_local", None) != 1 for mesh in meshes):
+        raise ValueError("segment runtime requires pp_local=1 for every segment")
+    if len(transitions) != max(0, len(splits) - 1):
+        raise ValueError("segment runtime requires transition metadata for every boundary")
+    for index, transition in enumerate(transitions):
+        if transition.source_stage_id != stage_id or transition.target_stage_id != stage_id:
+            raise ValueError("segment runtime transition stage ids must match current stage")
+        if transition.source_segment_index != index or transition.target_segment_index != index + 1:
+            raise ValueError("segment runtime transition indexes must be contiguous")
+
+
+def _clone_segment_pg_collection(base_pg_collection, stage_id, segment_index, mesh):
+    collection = ProcessGroupCollection()
+    for name in (
+        "pp",
+        "mp",
+        "embd",
+        "pos_embd",
+        "dp_cp",
+        "expt_dp",
+        "intra_dp_cp",
+        "intra_expt_dp",
+        "inter_dist_opt",
+    ):
+        if hasattr(base_pg_collection, name):
+            setattr(collection, name, getattr(base_pg_collection, name))
+    collection.tp = parallel_state.get_segment_process_group(stage_id, segment_index, "tp")
+    collection.dp = parallel_state.get_segment_process_group(stage_id, segment_index, "dp")
+    collection.cp = parallel_state.get_segment_process_group(stage_id, segment_index, "cp")
+    collection.tp_cp = parallel_state.get_segment_process_group(stage_id, segment_index, "tp-cp")
+    collection.tp_dp_cp = parallel_state.get_segment_process_group(
+        stage_id, segment_index, "tp-dp-cp"
+    )
+    if mesh.expert_model_parallel_size > 1:
+        collection.ep = parallel_state.get_segment_process_group(
+            stage_id, segment_index, "ep", True
+        )
+        collection.expt_tp = parallel_state.get_segment_process_group(
+            stage_id, segment_index, "tp", True
+        )
+        collection.tp_ep = parallel_state.get_segment_process_group(
+            stage_id, segment_index, "tp-ep", True
+        )
+        collection.tp_ep_pp = parallel_state.get_segment_process_group(
+            stage_id, segment_index, "tp-ep-pp", True
+        )
+    return collection
+
+
+def _segment_layer_config(base_config, stage_id, mesh):
+    config = replace(
+        base_config,
+        tensor_model_parallel_size=mesh.tensor_model_parallel_size,
+        context_parallel_size=mesh.context_parallel_size,
+        expert_model_parallel_size=mesh.expert_model_parallel_size,
+        sequence_parallel=base_config.sequence_parallel
+        and mesh.tensor_model_parallel_size > 1,
+        segment_stage_id=stage_id,
+    )
+    config.data_parallel_size = mesh.data_parallel_size
+    return config
+
+
+def _build_segment_execution_layers(
+    build_layer,
+    layer_specs,
+    base_config,
+    stage_id,
+    stage_spec,
+    base_pg_collection,
+):
+    expected_layers = sum(stage_spec.segment_splits)
+    if expected_layers != len(layer_specs):
+        raise ValueError("segment runtime splits must match the stage layer specs")
+    execution_layers = []
+    spec_index = 0
+    stage_shell_mesh = _stage_shell_mesh(base_config)
+    last_segment_pg_collection = None
+    last_segment_mesh = None
+    for segment_index, segment_layers in enumerate(stage_spec.segment_splits):
+        mesh = stage_spec.segment_meshes[segment_index]
+        segment_mesh = _mesh_dict_from_segment(mesh)
+        segment_config = _segment_layer_config(base_config, stage_id, mesh)
+        segment_pg_collection = _clone_segment_pg_collection(
+            base_pg_collection,
+            stage_id,
+            segment_index,
+            mesh,
+        )
+        if segment_index == 0:
+            _append_stage_shell_boundary(
+                execution_layers,
+                stage_id,
+                -1,
+                segment_index,
+                stage_shell_mesh,
+                segment_mesh,
+                base_pg_collection,
+                segment_pg_collection,
+                base_config,
+            )
+        segment_modules = []
+        for _ in range(segment_layers):
+            segment_modules.append(
+                build_layer(
+                    layer_specs[spec_index],
+                    spec_index + 1,
+                    segment_config,
+                    segment_pg_collection,
+                )
+            )
+            spec_index += 1
+        execution_layers.append(
+            SegmentModuleBlock(
+                stage_id,
+                segment_index,
+                segment_config,
+                segment_pg_collection,
+                segment_modules,
+            )
+        )
+        if segment_index < len(stage_spec.segment_splits) - 1:
+            transition = stage_spec.transitions[segment_index]
+            next_pg_collection = _clone_segment_pg_collection(
+                base_pg_collection,
+                stage_id,
+                segment_index + 1,
+                stage_spec.segment_meshes[segment_index + 1],
+            )
+            execution_layers.append(
+                SegmentRedistributionBoundary(
+                    stage_id,
+                    segment_index,
+                    segment_index + 1,
+                    transition,
+                    segment_pg_collection,
+                    next_pg_collection,
+                )
+            )
+        last_segment_pg_collection = segment_pg_collection
+        last_segment_mesh = segment_mesh
+    _append_stage_shell_boundary(
+        execution_layers,
+        stage_id,
+        len(stage_spec.segment_splits) - 1,
+        len(stage_spec.segment_splits),
+        last_segment_mesh,
+        stage_shell_mesh,
+        last_segment_pg_collection,
+        base_pg_collection,
+        base_config,
+    )
+    return torch.nn.ModuleList(execution_layers)
+
